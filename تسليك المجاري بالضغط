        "نوع العقار: " + encodeURIComponent(property || "غير محدد") + "%0A" +
        "نوع المشكلة: " + encodeURIComponent(problem || "غير محددة") + "%0A" +
        "مصدر الزيارة: " + encodeURIComponent(referral.source || "direct") + "%0A" +
        "الحملة: " + encodeURIComponent(referral.campaign || "") + "%0A" +
        "الكلمة: " + encodeURIComponent(referral.keyword || "") + "%0A" +
        "رابط الصفحة: " + encodeURIComponent(window.location.href);

      return "https://wa.me/" + window.BS_TRACKING_CONFIG.whatsappPhone + "?text=" + msg;
    }

    function bsSubmitLeadForm(event){
      event.preventDefault();

      if (!bsCanTrack("lead_form")) {
        alert("تم تسجيل الطلب بالفعل. يرجى الانتظار قليلًا قبل إرسال طلب آخر.");
        return false;
