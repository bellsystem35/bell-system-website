      };

      try {
        if (!localStorage.getItem("bs_first_referral")) {
          localStorage.setItem("bs_first_referral", JSON.stringify(saved));
        }
        localStorage.setItem("bs_last_referral", JSON.stringify(saved));
      } catch(e) {}
    })();

    function bsGetReferralData(){
      try {
        return JSON.parse(localStorage.getItem("bs_last_referral") || localStorage.getItem("bs_first_referral") || "{}");
      } catch(e) {
        return {};
      }
    }

    function bsCanTrack(actionType){
      var key = "bs_last_" + actionType + "_click_time";
      var now = Date.now();
      var cooldown = (window.BS_TRACKING_CONFIG.cooldownSeconds || 45) * 1000;

      try {
        var last = parseInt(localStorage.getItem(key) || "0", 10);
        if (now - last < cooldown) {
          return false;
        }
        localStorage.setItem(key, String(now));
        return true;
      } catch(e) {
        return true;
      }
    }

    function bsTrackGoogleAds(actionType){
      var cfg = window.BS_TRACKING_CONFIG || {};
      var sendTo = "";

      if (actionType === "phone") {
        sendTo = cfg.googleAdsId + "/" + cfg.phoneConversionLabel;
      }

      if (actionType === "whatsapp" || actionType === "lead_form") {
        sendTo = cfg.googleAdsId + "/" + cfg.whatsappConversionLabel;
      }

      if (
        typeof gtag === "function" &&
        cfg.googleAdsId &&
        sendTo.indexOf("XXXXXXXXXX") === -1 &&
        sendTo.indexOf("CONVERSION_LABEL") === -1
      ) {
        gtag("event", "conversion", {"send_to": sendTo});
      }
    }

    function bsLogLead(actionType){
      var referral = bsGetReferralData();
      var payload = {
        action: actionType,
        page: window.location.href,
        title: document.title,
        time: new Date().toISOString(),
        source: referral.source || "",
        medium: referral.medium || "",
        campaign: referral.campaign || "",
        keyword: referral.keyword || "",
        content: referral.content || "",
        gclid: referral.gclid || ""
      };

      try {
        var history = JSON.parse(localStorage.getItem("bs_lead_history") || "[]");
        history.push(payload);
        localStorage.setItem("bs_lead_history", JSON.stringify(history.slice(-30)));
      } catch(e) {}

      return payload;
    }

    function bsTrackLeadClick(event, actionType, element){
      var allowed = bsCanTrack(actionType);
      var href = element.getAttribute("href");

      if (!allowed) {
        event.preventDefault();
        alert("تم تسجيل طلبك بالفعل. يرجى الانتظار قليلًا قبل إعادة المحاولة.");
        return false;
      }

      bsLogLead(actionType);
      bsTrackGoogleAds(actionType);

      if (actionType === "phone") {
        event.preventDefault();
        setTimeout(function(){
          window.location.href = href;
        }, 250);
        return false;
      }

      return true;
    }

