function bsCanTrack(actionType){
  var key = "bs_last_" + actionType + "_click_time";
  var now = Date.now();
  var cooldown = (window.BS_TRACKING_CONFIG.cooldownSeconds || 45) * 1000;

  try {
    var last = parseInt(localStorage.getItem(key) || "0", 10);
